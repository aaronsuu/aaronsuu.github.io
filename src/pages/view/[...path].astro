---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Code } from 'astro:components';

const LANG_BY_EXT: Record<string, string> = {
  ts: 'typescript', tsx: 'tsx', js: 'javascript', jsx: 'jsx',
  py: 'python', rb: 'ruby', go: 'go', rs: 'rust',
  c: 'c', h: 'c', cpp: 'cpp', hpp: 'cpp', cc: 'cpp',
  java: 'java', kt: 'kotlin', swift: 'swift',
  cs: 'csharp', php: 'php',
  sh: 'bash', bash: 'bash', zsh: 'bash',
  json: 'json', yml: 'yaml', yaml: 'yaml', toml: 'toml',
  html: 'html', css: 'css', scss: 'scss',
  md: 'markdown', txt: 'text', ino: 'cpp',
  sql: 'sql', r: 'r', m: 'matlab',
};

export async function getStaticPaths() {
  const modules = import.meta.glob('/src/code/**/*.*', {
    eager: true,
    query: '?raw',
    import: 'default',
  }) as Record<string, string>;

  return Object.entries(modules).map(([fullPath, content]) => {
    const path = fullPath.replace('/src/code/', '');
    return {
      params: { path },
      props: { content, path },
    };
  });
}

const { content, path } = Astro.props;
const filename = path.split('/').pop() ?? path;
const ext = (filename.includes('.') ? filename.split('.').pop()! : '').toLowerCase();
const lang = LANG_BY_EXT[ext] ?? 'text';
const projectSlug = path.split('/')[0];
---

<BaseLayout title={`${filename} — Aaron Su`} description={`Source view: ${path}`}>
  <article class="vw-w">
    <a class="pd-back" href={`/projects/${projectSlug}`}>← Back to project</a>

    <div class="vw-head">
      <div class="vw-path">
        <span class="vw-crumb">{projectSlug}</span>
        <span class="vw-sep">/</span>
        <span class="vw-file">{filename}</span>
      </div>
      <div class="vw-meta">{lang} · {content.split('\n').length} lines</div>
    </div>

    <div class="vw-code">
      <Code code={content} lang={lang as any} theme="github-dark" wrap={false} />
    </div>
  </article>
</BaseLayout>
