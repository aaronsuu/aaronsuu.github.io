---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getRankedProjects, getRank } from '../lib/projects';

const featured = (await getRankedProjects()).filter((p) => getRank(p.id) === 'P1');
---

<BaseLayout title="Aaron Su — Portfolio">
  <section class="hero mx">
    <div class="hero-txt">
      <p class="greet">Hello, I'm</p>
      <h1>Aaron Su<br><span class="hero-role">Software Engineering with a focus on AI &amp; Embedded Systems</span></h1>
      <p class="tag">ECE student at the <a href="https://www.ece.uw.edu/" target="_blank">University of Washington</a> building machine learning for sensor and embedded systems. Research at HKUST, with work selected for a poster at ACM UbiComp-ISWC 2026.</p>
      <div class="cta-row">
        <a class="rbtn" href="/resume.pdf" download><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 2v8M3 7l4 4 4-4"/><line x1="2" y1="12" x2="12" y2="12"/></svg> Resume</a>
        <a class="gbtn" href="mailto:awjsu@uw.edu">Email me</a>
        <a class="gbtn" href="/projects">View projects</a>
      </div>
      <div class="status"><span class="dot"></span> Currently: <strong>Seeking Summer 2027 internships</strong> · Previously <a href="https://xmouyang.github.io/" target="_blank" style="color:inherit;border-bottom:1px solid var(--border)">MINSys Lab</a>, HKUST &amp; <a href="http://uwseal.com/" target="_blank" style="color:inherit;border-bottom:1px solid var(--border)">SEAL Lab</a>, UW</div>
      <div class="contacts">
        <a class="cl" href="mailto:awjsu@uw.edu"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="12" height="10" rx="2"/><path d="M2 5l6 4 6-4"/></svg> awjsu&#64;uw.edu</a>
        <a class="cl" href="tel:+12066058238"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2.5h2.5l1 3-1.5 1a8 8 0 0 0 4 4l1-1.5 3 1V13a1 1 0 0 1-1 1A11 11 0 0 1 2 3.5a1 1 0 0 1 1-1z"/></svg> (206) 605-8238</a>
        <a class="cl" href="https://linkedin.com/in/aaronsuuu/" target="_blank"><svg width="16" height="16" fill="currentColor"><path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12.5v-9zM5.3 6.8v4.7h-1.6V6.8h1.6zm-.8-2.5a.93.93 0 1 1 0 1.86.93.93 0 0 1 0-1.86zM11.7 11.5h-1.6V9.2c0-.6-.2-1-.7-1-.4 0-.6.3-.7.5v2.8H7.1V6.8h1.5v.6c.2-.3.6-.7 1.4-.7 1 0 1.7.7 1.7 2.1v2.7z"/></svg> LinkedIn</a>
        <a class="cl" href="https://github.com/aaronsuu" target="_blank"><svg width="16" height="16" fill="currentColor"><path d="M8 1.5A6.5 6.5 0 0 0 5.94 14.2c.33.06.44-.14.44-.31v-1.1c-1.8.39-2.18-.87-2.18-.87-.3-.75-.72-.95-.72-.95-.59-.4.04-.4.04-.4.65.05 1 .67 1 .67.58.99 1.52.7 1.89.54.06-.42.23-.7.41-.87-1.44-.16-2.95-.72-2.95-3.2 0-.7.25-1.28.67-1.73-.07-.16-.29-.82.06-1.71 0 0 .54-.17 1.78.66a6.2 6.2 0 0 1 3.24 0c1.23-.83 1.77-.66 1.77-.66.36.89.14 1.55.07 1.71.41.45.66 1.03.66 1.73 0 2.49-1.52 3.04-2.96 3.2.23.2.44.6.44 1.21v1.8c0 .17.12.37.45.31A6.5 6.5 0 0 0 8 1.5z"/></svg> GitHub</a>
      </div>
    </div>
    <div class="photo">
      <img src="/images/me.jpg" alt="Aaron Su" />
    </div>
  </section>

  <section class="featured mx">
    <div class="slabel">Featured Work</div>
    <div class="gg">
      {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
    <a class="feat-all" href="/projects">All projects →</a>
  </section>

  <div class="divider"></div>

  <section class="info mx">
    <div>
      <div class="slabel">Education</div>
      <div class="ti">
        <div class="ti-date">Sept 2024 — Jun 2028 (Expected)</div>
        <div class="ti-title">B.S. Electrical &amp; Computer Engineering</div>
        <div class="ti-sub"><a href="https://www.ece.uw.edu/" target="_blank">University of Washington</a> — Seattle, WA</div>
        <div class="ti-desc">Minors in <a href="https://dataminor.uw.edu/" target="_blank">Data Science</a> and <a href="https://ischool.uw.edu/" target="_blank">Informatics</a>. <strong>Related coursework:</strong> Data Structures &amp; Algorithms, Fundamentals of Machine Learning, Natural Language Processing (NLP), Cybersecurity, Computer Communication Networks, Data Science, Signals &amp; Systems, Digital Logic Design.</div>
      </div>
    </div>
    <div>
      <div class="slabel">Experience</div>
      <div class="ti">
        <div class="ti-date">Jun 2026 — Aug 2026</div>
        <div class="ti-title">Research Intern — Machine Learning &amp; AI</div>
        <div class="ti-sub"><a href="https://xmouyang.github.io/" target="_blank">MINSys Lab</a> — <a href="https://hkust.edu.hk/" target="_blank">HKUST</a>, Hong Kong</div>
        <div class="ti-desc"><ul class="ti-list"><li>Developed multimodal human activity recognition models in PyTorch for the <strong>CUHK-X Challenge</strong> (CUHK AIoT Lab), a 40-class benchmark across depth, IMU, thermal, and skeleton modalities; <strong>selected for poster presentation at ACM UbiComp-ISWC 2026</strong> in Shanghai.</li><li>Built preprocessing and encoder pipelines across three heterogeneous sensor streams (vision-derived 3D skeleton keypoints, wearable IMU accelerometer and gyroscope series, thermal infrared arrays), handling differing sampling rates, temporal alignment, and per-channel normalization.</li><li>Designed and trained three sensor-specific encoders in PyTorch (spatio-temporal skeleton transformer, IMU encoder, thermal transformer) on data from 24 subjects, unified by a confidence-weighted late-fusion layer.</li><li>Found and fixed a subject leak in the evaluation and moved to 3-fold cross-subject validation; reached 0.55 on the Kaggle leaderboard, up from 0.40.</li><li><a href="/projects/cuhk-x-har">Full writeup →</a></li></ul></div>
        <div class="ti-badges"><span class="badge">Edge AI</span><span class="badge">Computer Vision</span><span class="badge">Deep Learning</span><span class="badge">PyTorch</span><span class="badge">Multimodal</span></div>
      </div>
      <div class="ti">
        <div class="ti-date">Sept 2025 — Jun 2026</div>
        <div class="ti-title">Software Engineer &amp; Student Researcher</div>
        <div class="ti-sub"><a href="http://uwseal.com/" target="_blank">SEAL Lab</a> — University of Washington</div>
        <div class="ti-desc"><ul class="ti-list"><li>Built a Playwright automation that pulls software license usage data across shared workstations serving <strong>120+ researchers</strong>, replacing manual tracking with continuous monitoring.</li><li>Designed a cost model on that usage data that flags when buying an additional license beats paying per-use costs, saving the lab ~<strong>$1,500</strong>.</li><li>Deployed three prompt-engineered LLM assistants over a structured Obsidian knowledge base, cutting new-member onboarding from <strong>7 days to 3</strong> on average.</li><li>Took initiative to document 5 legacy JavaScript codebases inherited from prior researchers, making maintenance and troubleshooting <strong>50% faster</strong> and letting future members run and extend the code.</li><li>Automated recurring lab operations in JavaScript and Google Apps Script across document handling, tracking, and reporting.</li></ul></div>
        <div class="ti-badges"><span class="badge">Python</span><span class="badge">JavaScript</span><span class="badge">Playwright</span><span class="badge">LLMs</span><span class="badge">Automation</span></div>
      </div>
      <div class="ti">
        <div class="ti-date">Sept 2022 — Present</div>
        <div class="ti-title">Licensed Emergency Medical Responder</div>
        <div class="ti-sub">Community First Responders — City of Richmond, BC</div>
        <div class="ti-desc"><ul class="ti-list"><li>Licensed EMR in British Columbia with full <a href="https://www2.gov.bc.ca/gov/content/health/about-bc-s-health-care-system/partners/colleges-boards-and-commissions/emergency-medical-assistants-licensing-board/licensing" target="_blank">EMALB Schedule 2 endorsements</a>.</li><li>Treated <strong>150+ patients</strong> at events with 1,000+ attendees.</li><li>Coordinated multi-person teams across event zones, assigning roles and adapting plans as conditions changed.</li><li>Delivered concise, structured patient handoffs to paramedics and wrote incident reports under time pressure. Awarded a City of Richmond Scholarship.</li></ul></div>
      </div>
      <div class="ti">
        <div class="ti-date">Jan 2022 — Jun 2024</div>
        <div class="ti-title">CNC Specialist — FIRST Robotics</div>
        <div class="ti-sub">J.N. Burnett Secondary — Richmond, BC</div>
        <div class="ti-desc">Designed robot parts for multinational competition. 3rd place regional finish (2022). Led 15 youth in CNC fabrication and skill development.</div>
        <div class="ti-badges"><span class="badge">Fusion 360</span><span class="badge">CNC</span><span class="badge">CAD</span></div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="skills mx" style="padding-top:64px;">
    <div class="slabel">Languages</div>
    <div class="sk-grid"><span class="sk">Python</span><span class="sk">Java</span><span class="sk">MATLAB</span><span class="sk">R</span><span class="sk">JavaScript</span><span class="sk">SystemVerilog</span><span class="sk">C/C++</span><span class="sk">SQL</span></div>
    <div class="slabel" style="margin-top:28px;">Hardware / Embedded</div>
    <div class="sk-grid"><span class="sk">TCP/IP sockets</span><span class="sk">Multithreading</span><span class="sk">ESP32</span><span class="sk">Arduino</span><span class="sk">KiCad</span><span class="sk">Quartus</span><span class="sk">ModelSim</span></div>
    <div class="slabel" style="margin-top:28px;">Libraries</div>
    <div class="sk-grid"><span class="sk">PyTorch</span><span class="sk">scikit-learn</span><span class="sk">Hugging Face Transformers</span><span class="sk">NumPy</span><span class="sk">pandas</span><span class="sk">Matplotlib</span></div>
    <div class="slabel" style="margin-top:28px;">Tools</div>
    <div class="sk-grid"><span class="sk">Git/GitHub</span><span class="sk">Linux</span><span class="sk">pytest</span><span class="sk">Playwright</span><span class="sk">Docker</span><span class="sk">Jupyter</span></div>
    <div class="slabel" style="margin-top:28px;">Design &amp; Fabrication</div>
    <div class="sk-grid"><span class="sk">Fusion 360</span><span class="sk">AutoCAD</span><span class="sk">MultiSIM</span><span class="sk">PCB Design</span><span class="sk">CNC Fabrication</span><span class="sk">3D Printing</span></div>
    <div class="slabel" style="margin-top:40px;">Languages</div>
    <div class="sk-grid">
      <span class="sk">English (Native)</span><span class="sk">Cantonese (Native)</span><span class="sk">Mandarin (Limited Working)</span><span class="sk">Japanese (Elementary)</span>
    </div>
  </section>

  <div class="divider"></div>

  <section class="bio mx">
    <div class="slabel">About Me</div>
    <div class="bio-grid">
      <div>
        <p>I'm an <strong>Electrical &amp; Computer Engineering</strong> student at the <a href="https://www.ece.uw.edu/" target="_blank"><em>University of Washington</em></a> with minors in <a href="https://dataminor.uw.edu/" target="_blank"><em>Data Science</em></a> and <a href="https://ischool.uw.edu/" target="_blank"><em>Informatics</em></a>. My work spans hardware and machine learning, from PCBs and microcontrollers to multimodal deep learning and network protocols built from scratch.</p>
        <p>Alongside engineering, I'm a <strong>licensed Emergency Medical Responder</strong> with the City of Richmond. It taught me to stay calm under pressure, communicate clearly, and make decisions when the stakes are real.</p>
      </div>
      <div>
        <div class="bio-hl">I'm driven by the belief that the best engineers understand problems at every layer, from the silicon to the user interface. Whether it's a CNC-machined robot part or a neural network, I want to build things that matter.</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="cta mx" style="padding-top:64px;">
    <h2>Let's talk</h2>
    <p>Seeking Summer 2027 internships. The fastest way to reach me is email.</p>
    <a class="cta-btn" href="mailto:awjsu@uw.edu">Email me</a>
  </section>

  <div class="divider"></div>

  <section class="interests mx" style="padding-top:64px;">
    <div class="slabel">When I'm Not Engineering</div>
    <div class="int-grid">
      <div><div class="int-h"><span class="em">🏎️</span> Formula 1</div><p class="int-p">Supporting <a href="https://www.mercedesamgf1.com/" target="_blank">Mercedes</a>, <a href="https://www.ferrari.com/en-EN/formula1" target="_blank">Ferrari</a>, and Max Verstappen. Race weekends are sacred.</p></div>
      <div><div class="int-h"><span class="em">☕</span> Coffee</div><p class="int-p">A latte with a <a href="https://wiltonbenitez.com/" target="_blank">Wilton Benitez</a> Colombian blend is as close to perfect as it gets.</p></div>
      <div><div class="int-h"><span class="em">🚇</span> Transit Systems</div><p class="int-p">Fan of <a href="https://www.soundtransit.org/ride-with-us/stations/link-light-rail-stations" target="_blank">Link Light Rail</a>, Hong Kong's <a href="https://www.mtr.com.hk/" target="_blank">MTR</a>, <a href="https://www.tokyometro.jp/en/" target="_blank">Tokyo Metro</a>, JR, and SkyTrain.</p></div>
      <div><div class="int-h"><span class="em">📷</span> Photography</div><p class="int-p">Street and travel shots on a Sony A7II with a Sigma 30mm f/1.4.</p></div>
      <div><div class="int-h"><span class="em">🎧</span> Music</div><p class="int-p">Coldplay, Maroon 5, and <a href="https://open.spotify.com/artist/2elBjNSdBE2Y3f0j1mjrql" target="_blank">Jay Chou</a>. Always happy to swap playlists.</p></div>
    </div>
  </section>
</BaseLayout>
